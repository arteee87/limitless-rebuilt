{
  "schemaVersion": 1,
  "id": "limitless-rebuilt",
  "name": "Limitless Rebuilt",
  "version": "@version@",
  "description": "Removes the enchanting level ceiling: unlimited levels, reenchanting, configurable enchanting power and anvil behaviour. Port of the mod \"limitless\" by auoeke",
  "contact": {
    "sources": "https://github.com/arteee87/limitless-rebuilt",
    "issues": "https://github.com/arteee87/limitless-rebuilt/issues"
  },
  "authors": [
    "arteee87",
    "auoeke (original)"
  ],
  "license": "LGPL-3.0-only",
  "icon": "assets/limitless-rebuilt/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "limitless_rebuilt.Limitless"
    ],
    "client": [
      "limitless_rebuilt.Limitless"
    ],
    "modmenu": [
      "limitless_rebuilt.Limitless$ModMenu"
    ]
  },
  "mixins": [
    "limitless-rebuilt.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.4",
    "cloth-config": ">=21.11.150"
  },
  "recommends": {
    "modmenu": ">=17.0.0"
  }
}
